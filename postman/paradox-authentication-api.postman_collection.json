                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "description": "(Required) Account ID provided by Paradox",
                      "key": "client_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Secret key provided by Paradox",
                      "key": "client_secret",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) OAuth 2.0 grant type",
                      "key": "grant_type",
                      "value": "client_credentials"
